{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run CSV Batch",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "args": [
                "companies.csv",
                "--csv-column",
                "company",
                "--country-column",
                "country",
                "--product-column",
                "product",
                "--out",
                "results_debug.csv"
            ]
        }
    ]
}